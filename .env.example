# Storytelling Agent Configuration

# LLM / API Keys
OPENAI_API_KEY=your_openai_api_key_here

# Research Integration (Web Search + Scraping)
# Enable/disable research capabilities
RESEARCH_ENABLED=true

# Maximum number of web search results to retrieve per query (default: 5)
SEARCH_MAX_RESULTS=5

# Maximum number of URLs to scrape for content extraction (default: 3)
SCRAPE_MAX_URLS=3

# Story Generation
# Maximum tokens for narrative generation
NARRATIVE_MAX_TOKENS=4000

# Framework and knowledge base paths (optional)
# KNOWLEDGE_BASE_PATH=./knowledge_base

# Logging
LOG_LEVEL=INFO

# Session/State Management
# DATABASE_URL=postgresql://user:password@localhost/storytelling_agent
